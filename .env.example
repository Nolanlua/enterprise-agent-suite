# 环境
APP_ENV=local
LOG_LEVEL=INFO
TENANT_HEADER=X-Tenant-Id
JWT_SECRET=replace-me-in-secret-manager
JWT_ALGORITHM=HS256

# 数据库
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0

# 对象存储
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=agent-platform

# 向量与检索
QDRANT_URL=http://localhost:6333
OPENSEARCH_URL=http://localhost:9200
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123

# 模型服务
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-large
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 中台地址
DATA_PLATFORM_URL=http://localhost:8001
EVAL_PLATFORM_URL=http://localhost:8002
ORDER_SERVICE_URL=http://localhost:8020
ORDER_SERVICE_TOKEN=internal-token

# 评测
EVAL_MAX_CONCURRENCY=4
EVAL_JUDGE_MODEL=gpt-4.1-mini
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
